# All core Tier A/B sources work with NO keys. Everything here is optional and
# expands coverage. `uv run dcgeo doctor` shows what is active.

# ── Free, registration only ──────────────────────────────────────────────────
OPENTOPOGRAPHY_API_KEY=          # higher DEM rate limits (portal.opentopography.org)
EIA_API_KEY=                     # US power prices and reliability (api.eia.gov)
OPENAQ_API_KEY=                  # air quality (api.openaq.org)
PROTECTED_PLANET_TOKEN=          # WDPA protected areas
ELECTRICITY_MAPS_KEY=            # hourly grid carbon (free tier: one zone)
CDS_API_KEY=                     # Copernicus Climate Data Store
CLOUDFLARE_RADAR_TOKEN=          # latency and network data
CENSUS_API_KEY=                  # US demographics
BLS_API_KEY=                     # US labor statistics

# ── Paid — adapters are written but skip cleanly without these ───────────────
GEE_SERVICE_ACCOUNT_JSON=        # Google Earth Engine (free for research)
PLANET_API_KEY=                  # Planet Labs daily 3m imagery
FATHOM_API_KEY=                  # Fathom global flood model
COSTAR_API_KEY=                  # US land price -> Tier A
REONOMY_API_KEY=                 # US property intelligence
SP_GLOBAL_API_KEY=               # interconnection and utility intelligence
TELEGEOGRAPHY_API_KEY=           # terrestrial fiber routes (the biggest data gap)
RSMEANS_API_KEY=                 # construction cost calibration
VAISALA_API_KEY=                 # lightning

# ── Self-hosting, for sweeps at scale ────────────────────────────────────────
# The public Overpass and Nominatim endpoints will rate-limit bulk use. Point these
# at your own instances before running large sweeps.
OVERPASS_ENDPOINT=
NOMINATIM_ENDPOINT=
